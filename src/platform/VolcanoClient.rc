// No #include <winver.h>: a plain shell has no INCLUDE path for the SDK, so its constants are written out.
#define VS_VERSION_INFO 1

// The file icon Explorer, the taskbar (before the window loads) and the Start Menu show. Built from resources/logo.png.
IDI_VOLCANO ICON "../../resources/logo.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L // VOS_NT_WINDOWS32
FILETYPE 0x1L // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Volcano Client"
            VALUE "ProductName", "Volcano Client"
            VALUE "InternalName", "VolcanoClient"
            VALUE "OriginalFilename", "VolcanoClient.exe"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
